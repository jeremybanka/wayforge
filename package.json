{
	"name": "@wayforge/monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "choose your path",
	"repository": "https://github.com/jeremybanka/wayforge",
	"license": "MPL-2.0",
	"author": "jeremybanka",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "dotenvx run -- turbo run build",
		"change": "changeset",
		"check": "pnpm run check:fmt && pnpm run check:deps && pnpm run check:eslint && pnpm run check:oxlint && pnpm run check:tsc && pnpm run check:tonnage && pnpm run check:lasertag",
		"check:deps": "pin-checker --ignore-workspaces",
		"check:eslint": "dotenvx run -- turbo run check:eslint",
		"check:fmt": "cross-env DPRINT_CACHE_DIR=$PWD/.cache/dprint dprint check .",
		"check:lasertag": "turbo run check:lasertag",
		"check:oxlint": "dotenvx run -- turbo run check:oxlint",
		"check:tonnage": "turbo run check:tonnage",
		"check:tsc": "dotenvx run -- turbo run check:tsc",
		"cov": "CI=true turbo run cov",
		"cov:check": "CI=true turbo run cov:check",
		"fmt": "cross-env DPRINT_CACHE_DIR=$PWD/.cache/dprint dprint fmt .",
		"gen": "dotenvx run -- turbo run gen",
		"lint:fix:eslint": "eslint --fix .",
		"release:hooks": "dotenvx run -- turbo run version",
		"release:publish": "bun run build && changeset publish",
		"release:version": "./scripts/version.sh",
		"test": "CI=true dotenvx run -- turbo run test --concurrency=2",
		"test:semver": "CI=true dotenvx run -- turbo run test:semver",
		"test:watch": "dotenvx run -- turbo run test:watch --concurrency=30",
		"tonnage:write": "turbo run tonnage:write",
		"vigilance": "bun scripts/vigilance-bot.bun.ts",
		"watch:types": "dotenvx run -- turbo run watch:types --concurrency=30",
		"workflows:update": "bun scripts/update-workflows.bun.ts"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dotenvx/dotenvx": "2.34.1",
		"@dprint/json": "0.25.2",
		"@dprint/markdown": "0.26.0",
		"@dprint/oxc": "0.44.0",
		"@dprint/toml": "0.9.0",
		"@types/eslint": "9.6.1",
		"@typescript-eslint/eslint-plugin": "8.71.1",
		"@typescript-eslint/parser": "8.71.1",
		"@typescript-eslint/utils": "8.71.1",
		"@typescript/native": "npm:typescript@7.0.2",
		"atom.io": "0.53.3",
		"cross-env": "10.1.0",
		"dprint": "0.61.1",
		"dprint-plugin-malva": "0.16.0",
		"dprint-plugin-markup": "0.27.5",
		"dprint-plugin-yaml": "0.6.0",
		"eslint-plugin-drizzle": "0.2.3",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"jiti": "2.7.0",
		"lasertag": "0.8.7",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2003",
		"pin-dependencies-checker": "2.7.1",
		"tonnage": "0.1.3",
		"turbo": "2.11.7",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vitest": "5.0.3"
	},
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": "26.11.1"
	}
}
