{
	"name": "@wayforge/monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "choose your path",
	"repository": "https://github.com/jeremybanka/wayforge",
	"license": "MPL-2.0",
	"author": "jeremybanka",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"gen": "dotenvx run -- turbo run gen",
		"lint": "dotenvx run -- turbo run lint",
		"lint:deps": "pin-checker --ignore-workspaces",
		"lint:eslint": "dotenvx run -- turbo run lint:eslint",
		"lint:oxlint": "dotenvx run -- turbo run lint:oxlint",
		"lint:types": "dotenvx run -- turbo run lint:types",
		"watch:types": "dotenvx run -- turbo run watch:types --concurrency=30",
		"lint:fix:eslint": "eslint --fix .",
		"fmt": "cross-env DPRINT_CACHE_DIR=$PWD/.cache/dprint dprint check .",
		"fmt:fix": "cross-env DPRINT_CACHE_DIR=$PWD/.cache/dprint dprint fmt .",
		"build": "dotenvx run -- turbo run build",
		"test": "CI=true dotenvx run -- turbo run test:once --concurrency=2",
		"test:coverage:increased": "CI=true turbo run test:coverage:increased",
		"test:semver": "CI=true dotenvx run -- turbo run test:semver",
		"tonnage:check": "turbo run tonnage:check",
		"tonnage:write": "turbo run tonnage:write",
		"release": "bun run build && changeset publish",
		"notes": "changeset",
		"vigilance": "bun scripts/vigilance-bot.bun.ts",
		"nuke": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && find . -name 'dist' -type d -prune -exec rm -rf '{}' + && rm pnpm-lock.yaml",
		"nv": "fnm use $(pnpm list -w --json | jq -r '.[0].path')",
		"version": "dotenvx run -- turbo run version",
		"upgrade-workflows": "bun scripts/update-workflows.bun.ts"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dotenvx/dotenvx": "2.26.1",
		"@dprint/json": "0.24.0",
		"@dprint/markdown": "0.24.0",
		"@dprint/oxc": "0.40.0",
		"@dprint/toml": "0.8.0",
		"@types/eslint": "9.6.1",
		"@typescript-eslint/eslint-plugin": "8.70.0",
		"@typescript-eslint/parser": "8.70.0",
		"@typescript-eslint/utils": "8.70.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"atom.io": "0.53.1",
		"cross-env": "10.1.0",
		"dprint": "0.57.4",
		"dprint-plugin-malva": "0.16.0",
		"dprint-plugin-markup": "0.27.3",
		"dprint-plugin-yaml": "0.6.0",
		"eslint-plugin-drizzle": "0.2.3",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"jiti": "2.7.0",
		"oxlint": "1.83.0",
		"oxlint-tsgolint": "7.0.2001",
		"pin-dependencies-checker": "2.7.1",
		"tonnage": "0.1.3",
		"turbo": "2.10.13",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vitest": "5.0.1"
	},
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": "26.9.0"
	}
}
