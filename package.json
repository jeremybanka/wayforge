{
	"name": "@wayforge/monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "choose your path",
	"repository": "https://github.com/jeremybanka/wayforge",
	"license": "MPL-2.0",
	"author": "jeremybanka",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "dotenvx run -- turbo run build",
		"change": "changeset",
		"check": "pnpm run check:fmt && pnpm run check:deps && pnpm run check:eslint && pnpm run check:oxlint && pnpm run check:tsc && pnpm run check:readme && pnpm run check:lasertag && pnpm run check:correctly",
		"check:correctly": "correctly check --offline",
		"check:deps": "pin-checker --ignore-workspaces",
		"check:eslint": "dotenvx run -- turbo run check:eslint",
		"check:fmt": "cross-env DPRINT_CACHE_DIR=$PWD/.cache/dprint dprint check .",
		"check:lasertag": "turbo run check:lasertag",
		"check:oxlint": "dotenvx run -- turbo run check:oxlint",
		"check:readme": "turbo run check:readme",
		"check:tonnage": "pnpm run check:readme",
		"check:tsc": "dotenvx run -- turbo run check:tsc",
		"cov": "CI=true turbo run cov",
		"cov:check": "CI=true turbo run cov:check",
		"fmt": "cross-env DPRINT_CACHE_DIR=$PWD/.cache/dprint dprint fmt .",
		"gen": "dotenvx run -- turbo run gen",
		"lint:fix:eslint": "eslint --fix .",
		"readme:write": "turbo run readme:write",
		"release:hooks": "dotenvx run -- turbo run version",
		"release:publish": "pnpm run build && changeset publish",
		"release:version": "./scripts/version.sh",
		"test": "CI=true dotenvx run -- turbo run test --concurrency=2",
		"test:breakage": "CI=true dotenvx run -- turbo run test:breakage",
		"test:watch": "dotenvx run -- turbo run test:watch --concurrency=30",
		"tonnage:write": "pnpm run readme:write",
		"vigilance": "bun scripts/vigilance-bot.bun.ts",
		"watch:types": "dotenvx run -- turbo run watch:types --concurrency=30",
		"workflows:update": "node scripts/update-workflows.node.ts"
	},
	"devDependencies": {
		"@atom.io/eslint-plugin": "0.1.0",
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@correctlyjs/schemars": "0.0.6",
		"@dotenvx/dotenvx": "2.38.2",
		"@dprint/json": "0.25.2",
		"@dprint/markdown": "0.28.1",
		"@dprint/oxc": "0.47.0",
		"@dprint/toml": "0.9.0",
		"@types/eslint": "9.6.1",
		"@typescript-eslint/eslint-plugin": "8.72.0",
		"@typescript-eslint/parser": "8.72.0",
		"@typescript-eslint/utils": "8.72.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"atom.io": "0.54.0",
		"correctly": "0.3.3",
		"cross-env": "10.1.0",
		"dprint": "0.64.3",
		"dprint-plugin-malva": "0.16.0",
		"dprint-plugin-markup": "0.27.6",
		"dprint-plugin-yaml": "0.6.0",
		"eslint-plugin-drizzle": "0.2.3",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"flightdeck": "workspace:*",
		"jiti": "2.7.0",
		"lasertag": "0.8.10",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2005",
		"pin-dependencies-checker": "2.7.1",
		"turbo": "2.11.10",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"varmint": "workspace:*",
		"vitest": "5.0.5"
	},
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": "26.12.1"
	}
}
