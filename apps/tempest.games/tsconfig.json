{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "@atom.io/spa",
		"target": "ES2020",
		"lib": [
			"ES2024",
			"DOM",
			"DOM.Iterable"
		],
		"types": [
			"@types/three",
			"vitest/globals",
			"node"
		],
		"paths": {
			"@backend/*": [
				"./src/backend/*"
			],
			"@database/*": [
				"./src/database/*"
			]
		}
	},
	"include": [
		"src",
		"types",
		"__tests__",
		"__scripts__",
		"**/*.config.ts",
		"**/*.bun.ts",
		"dev/https-dev.ts"
	],
	"exclude": []
}
