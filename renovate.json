{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"automerge": true,
	"branchConcurrentLimit": 9,
	"internalChecksFilter": "strict",
	"minimumReleaseAge": "1 day",
	"prConcurrentLimit": 3,
	"prHourlyLimit": 9,
	"pruneBranchAfterAutomerge": true,
	"pruneStaleBranches": true,
	"postUpdateOptions": ["pnpmDedupe"],
	"statusCheckWhen": { "minimumReleaseAge": "never" },
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github\\/actions\\/setup\\/action\\.yml$/"],
			"matchStrings": [
				"uses: jdx\\/mise-action@\\S+(?:\\s+#.*)?\\s+      with:\\s+        version: (?<currentValue>\\S+)"
			],
			"depNameTemplate": "jdx/mise",
			"datasourceTemplate": "github-releases",
			"versioningTemplate": "semver-coerced"
		}
	],
	"packageRules": [
		{
			"description": "Temporary Bun 1.4.4 release-age exception; remove after 2026-10-23 10:20 UTC. Keep aligned with pnpm-workspace.yaml.",
			"matchPackageNames": [
				"bun",
				"oven-sh/bun",
				"@oven/bun-*",
				"bun-types"
			],
			"matchJsonata": ["version = '1.4.4' or newVersion = '1.4.4'"],
			"minimumReleaseAge": null
		},
		{
			"description": "Temporary exception for the current @types/bun release; remove with the Bun 1.4.4 exception.",
			"matchDatasources": [
				"npm"
			],
			"matchPackageNames": [
				"@types/bun"
			],
			"matchJsonata": ["version = '1.4.3' or newVersion = '1.4.3'"],
			"minimumReleaseAge": null
		},
		{
			"matchManagers": ["npm"],
			"postUpgradeTasks": {
				"commands": [
					"pnpm install --frozen-lockfile",
					"pnpm readme:write"
				],
				"executionMode": "branch",
				"fileFilters": ["packages/*/README.md"]
			}
		},
		{
			"matchPackageNames": ["@typescript/*"],
			"minimumReleaseAge": null
		},
		{
			"description": "Exempt packages authored by jeremybanka at every version; keep aligned with pnpm-workspace.yaml",
			"matchDatasources": ["npm"],
			"matchPackageNames": [
				"atom.io",
				"break-check",
				"breakage",
				"comline",
				"flightdeck",
				"galley.md",
				"jurist",
				"lasertag",
				"luum",
				"rationality",
				"recoverage",
				"rel8",
				"safedeposit",
				"takua",
				"tonnage",
				"treetrunks",
				"tsdoc.json",
				"varmint",
				"venerate"
			],
			"minimumReleaseAge": null
		},
		{
			"matchManagers": ["github-actions"],
			"dependencyDashboardApproval": true
		},
		{
			"matchDepNames": ["jdx/mise"],
			"dependencyDashboardApproval": true
		},
		{
			"matchManagers": ["mise"],
			"matchDepNames": ["conda:zsh"],
			"registryUrls": ["https://api.anaconda.org/package/conda-forge"]
		},
		{
			"matchPackageNames": ["@biomejs/js-api", "@biomejs/wasm-nodejs"],
			"groupName": "biome"
		},
		{
			"matchPackageNames": ["tsdown", "@tsdown/css"],
			"groupName": "tsdown"
		},
		{
			"matchPackageNames": ["ai", "@ai-sdk/openai"],
			"groupName": "Vercel AI SDK"
		}
	]
}
