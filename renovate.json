{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"automerge": true,
	"branchConcurrentLimit": 9,
	"internalChecksFilter": "strict",
	"minimumReleaseAge": "1 day",
	"prConcurrentLimit": 3,
	"prHourlyLimit": 9,
	"pruneBranchAfterAutomerge": true,
	"pruneStaleBranches": true,
	"postUpdateOptions": ["pnpmDedupe"],
	"statusCheckWhen": { "minimumReleaseAge": "never" },
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github\\/actions\\/setup\\/action\\.yml$/"],
			"matchStrings": [
				"uses: jdx\\/mise-action@\\S+(?:\\s+#.*)?\\s+      with:\\s+        version: (?<currentValue>\\S+)"
			],
			"depNameTemplate": "jdx/mise",
			"datasourceTemplate": "github-releases",
			"versioningTemplate": "semver-coerced"
		}
	],
	"packageRules": [
		{
			"matchManagers": ["npm"],
			"postUpgradeTasks": {
				"commands": [
					"pnpm install --frozen-lockfile",
					"pnpm readme:write"
				],
				"executionMode": "branch",
				"fileFilters": ["packages/*/README.md"]
			}
		},
		{
			"description": "Exempt consumed jeremybanka packages at every version; keep aligned with pnpm-workspace.yaml",
			"matchDatasources": [
				"npm"
			],
			"matchPackageNames": [
				"@correctlyjs/schemars",
				"atom.io",
				"breakage",
				"comline",
				"correctly",
				"galley.md",
				"lasertag",
				"recoverage",
				"takua",
				"tonnage",
				"treetrunks"
			],
			"minimumReleaseAge": null
		},
		{
			"matchManagers": ["github-actions"],
			"dependencyDashboardApproval": true
		},
		{
			"matchDepNames": ["jdx/mise"],
			"dependencyDashboardApproval": true
		},
		{
			"matchManagers": ["mise"],
			"matchDepNames": ["conda:zsh"],
			"registryUrls": ["https://api.anaconda.org/package/conda-forge"]
		},
		{
			"matchPackageNames": ["@biomejs/js-api", "@biomejs/wasm-nodejs"],
			"groupName": "biome"
		},
		{
			"matchPackageNames": ["tsdown", "@tsdown/css"],
			"groupName": "tsdown"
		},
		{
			"matchPackageNames": ["ai", "@ai-sdk/openai"],
			"groupName": "Vercel AI SDK"
		},
		{
			"matchPackageNames": [
				"dprint",
				"@dprint/*",
				"/^dprint-plugin-/"
			],
			"postUpgradeTasks": {
				"commands": [
					"pnpm install --frozen-lockfile",
					"pnpm exec correctly schemas pull --association 'Dprint'",
					"pnpm readme:write"
				],
				"executionMode": "branch",
				"fileFilters": [
					".correctly/**",
					"packages/*/README.md"
				],
				"installTools": {
					"node": {},
					"pnpm": {}
				}
			}
		},
		{
			"matchPackageNames": [
				"renovatebot/github-action",
				"ghcr.io/renovatebot/renovate"
			],
			"postUpgradeTasks": {
				"commands": [
					"pnpm install --frozen-lockfile",
					"pnpm exec correctly schemas pull --association 'Renovate'",
					"pnpm readme:write"
				],
				"executionMode": "branch",
				"fileFilters": [
					".correctly/**",
					"packages/*/README.md"
				],
				"installTools": {
					"node": {},
					"pnpm": {}
				}
			}
		},
		{
			"matchPackageNames": [
				"jdx/mise",
				"jdx/mise-action"
			],
			"postUpgradeTasks": {
				"commands": [
					"pnpm install --frozen-lockfile",
					"pnpm exec correctly schemas pull --association 'Mise'",
					"pnpm readme:write"
				],
				"executionMode": "branch",
				"fileFilters": [
					".correctly/**",
					"packages/*/README.md"
				],
				"installTools": {
					"node": {},
					"pnpm": {}
				}
			}
		},
		{
			"matchPackageNames": [
				"pnpm"
			],
			"postUpgradeTasks": {
				"commands": [
					"pnpm install --frozen-lockfile",
					"pnpm exec correctly schemas pull --association 'pnpm workspace'",
					"pnpm readme:write"
				],
				"executionMode": "branch",
				"fileFilters": [
					".correctly/**",
					"packages/*/README.md"
				],
				"installTools": {
					"node": {},
					"pnpm": {}
				}
			}
		}
	]
}
