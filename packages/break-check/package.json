{
	"name": "break-check",
	"version": "0.8.2",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/wayforge.git",
		"directory": "packages/break-check"
	},
	"license": "MPL-2.0",
	"author": {
		"name": "Jeremy Banka",
		"email": "hello@jeremybanka.com"
	},
	"type": "module",
	"main": "dist/break-check.js",
	"types": "dist/break-check.d.ts",
	"bin": {
		"break-check": "./bin/break-check.bin.js"
	},
	"files": [
		"bin",
		"dist",
		"src",
		"break-check.schema.json"
	],
	"scripts": {
		"build": "tsdown && pnpm run schema",
		"check": "pnpm run check:eslint && pnpm run check:tsc && pnpm run check:oxlint",
		"check:eslint": "eslint -- .",
		"check:oxlint": "oxlint --type-aware -c ../../.oxlintrc.jsonc .",
		"check:tsc": "tsc --noEmit",
		"postversion": "dprint fmt package.json",
		"schema": "bun src/break-check.x.ts --outdir=dist -- schema",
		"test": "bun test -- **/*.test.ts",
		"test:watch": "bun test --watch -- **/*.test.ts",
		"watch:types": "tsc --watch --noEmit"
	},
	"dependencies": {
		"arktype": "2.2.8",
		"comline": "workspace:*",
		"minimatch": "10.2.6",
		"simple-git": "4.0.2",
		"takua": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "npm:bun-types@1.4.2",
		"concurrently": "10.0.6",
		"eslint": "10.12.0",
		"tsdown": "0.23.0",
		"typescript": "7.0.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
