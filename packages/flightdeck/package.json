{
	"name": "flightdeck",
	"version": "0.5.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/wayforge.git",
		"directory": "packages/flightdeck"
	},
	"license": "MPL-2.0",
	"author": {
		"name": "Jeremy Banka",
		"email": "hello@jeremybanka.com"
	},
	"type": "module",
	"main": "dist/lib.js",
	"types": "dist/lib.d.ts",
	"bin": {
		"flightdeck": "./bin/flightdeck.bin.js",
		"klaxon": "./bin/klaxon.bin.js"
	},
	"files": [
		"dist",
		"gen",
		"src"
	],
	"scripts": {
		"build": "tsdown && bun ./__scripts__/build-lnav.bun.ts",
		"check": "pnpm run check:eslint && pnpm run check:tsc && pnpm run check:oxlint",
		"check:eslint": "eslint -- .",
		"check:oxlint": "oxlint --type-aware -c ../../.oxlintrc.jsonc .",
		"check:tsc": "tsc --noEmit",
		"gen": "node ./__scripts__/gen.node.ts",
		"postversion": "dprint fmt package.json",
		"schema:flightdeck": "bun ./src/flightdeck.bin.ts --outdir=dist -- schema",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"watch:types": "tsc --watch --noEmit"
	},
	"dependencies": {
		"@t3-oss/env-core": "0.13.11",
		"arktype": "2.2.9",
		"atom.io": "0.53.3",
		"comline": "workspace:*",
		"cron": "4.4.0",
		"safedeposit": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/js-api": "6.1.0",
		"@biomejs/wasm-nodejs": "2.6.2",
		"@types/bun": "npm:bun-types@1.4.4",
		"@types/node": "26.6.5",
		"concurrently": "10.0.6",
		"eslint": "10.13.0",
		"json-schema-to-zod": "2.8.1",
		"tsdown": "0.23.1",
		"typescript": "7.0.2",
		"varmint": "workspace:*",
		"vitest": "5.0.5",
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"zod": "^4"
	},
	"publishConfig": {
		"access": "public"
	}
}
