{
	"name": "treetrunks",
	"version": "0.1.13",
	"description": "Lean utilities to build type-safe trees and validate routes through them.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/wayforge.git",
		"directory": "packages/treetrunks"
	},
	"license": "MPL-2.0",
	"author": {
		"name": "Jeremy Banka",
		"email": "hello@jeremybanka.com"
	},
	"type": "module",
	"main": "dist/treetrunks.js",
	"types": "dist/treetrunks.d.ts",
	"files": [
		"AGENTS.md",
		"__tests__",
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"check": "pnpm run check:eslint && pnpm run check:tsc && pnpm run check:oxlint && pnpm run check:readme",
		"check:eslint": "eslint -- .",
		"check:oxlint": "oxlint --type-aware -c ../../.oxlintrc.jsonc .",
		"check:readme": "galley check README.mdx",
		"check:tonnage": "pnpm run check:readme",
		"check:tsc": "tsc --noEmit",
		"cov": "vitest run --coverage",
		"cov:check": "pnpm run cov && recoverage",
		"postversion": "dprint fmt package.json",
		"readme:write": "galley write README.mdx",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"tonnage:write": "pnpm run readme:write",
		"watch:types": "tsc --watch --noEmit"
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"concurrently": "10.0.6",
		"eslint": "10.13.0",
		"galley.md": "0.3.1",
		"recoverage": "0.1.20",
		"tonnage": "0.5.2",
		"tsdown": "0.23.3",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"publishConfig": {
		"access": "public"
	}
}
