{
	"name": "varmint",
	"version": "0.6.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/wayforge.git",
		"directory": "packages/varmint"
	},
	"license": "MPL-2.0",
	"author": {
		"name": "Jeremy Banka",
		"email": "hello@jeremybanka.com"
	},
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"varmint": "bin/varmint.bin.js"
	},
	"files": [
		"AGENTS.md",
		"dist",
		"src",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsdown",
		"check": "pnpm run check:eslint && pnpm run check:tsc && pnpm run check:oxlint && pnpm run check:tonnage",
		"check:eslint": "eslint -- .",
		"check:oxlint": "oxlint --type-aware -c ../../.oxlintrc.jsonc .",
		"check:tonnage": "tonnage check",
		"check:tsc": "tsc --noEmit",
		"clean:build": "rm -rf dist",
		"postversion": "dprint fmt package.json",
		"test": "./bin/varmint.bin.js track && vitest run; test_status=$?; ./bin/varmint.bin.js clean --ci-flag=CI; cleanup_status=$?; if [ \"$test_status\" -ne 0 ]; then exit \"$test_status\"; fi; exit \"$cleanup_status\"",
		"test:watch": "vitest --watch",
		"tonnage:write": "tonnage write",
		"watch:types": "tsc --watch --noEmit"
	},
	"dependencies": {
		"arktype": "2.2.7",
		"cachedir": "2.4.0",
		"comline": "workspace:*",
		"diff": "9.0.0",
		"fastest-levenshtein": "1.0.16",
		"safedeposit": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "npm:bun-types@1.4.2",
		"@types/node": "26.6.4",
		"atom.io": "0.53.3",
		"concurrently": "10.0.5",
		"eslint": "10.12.0",
		"openai": "7.28.0",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"vite": "8.3.3",
		"vitest": "5.0.3",
		"yalc": "1.0.0-pre.53",
		"zod": "4.6.5"
	},
	"publishConfig": {
		"access": "public"
	}
}
