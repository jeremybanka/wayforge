{
	"name": "venerate",
	"version": "0.0.6",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/wayforge.git",
		"directory": "packages/venerate"
	},
	"license": "MPL-2.0",
	"author": {
		"name": "Jeremy Banka",
		"email": "hello@jeremybanka.com"
	},
	"type": "module",
	"main": "dist/venerate.js",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"check": "pnpm run check:eslint && pnpm run check:tsc && pnpm run check:oxlint && pnpm run check:tonnage",
		"check:eslint": "eslint -- .",
		"check:oxlint": "oxlint --type-aware -c ../../.oxlintrc.jsonc .",
		"check:tonnage": "tonnage check",
		"check:tsc": "tsc --noEmit",
		"cov": "vitest run --coverage",
		"postversion": "dprint fmt package.json",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"tonnage:write": "tonnage write",
		"watch:types": "tsc --watch --noEmit"
	},
	"devDependencies": {
		"@types/node": "26.6.3",
		"@vitest/coverage-v8": "5.0.3",
		"concurrently": "10.0.5",
		"eslint": "10.11.0",
		"recoverage": "0.1.19",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"vite": "8.3.1",
		"vitest": "5.0.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
