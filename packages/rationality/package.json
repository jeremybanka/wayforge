{
	"name": "rationality",
	"version": "0.1.1",
	"description": "Lossless numbers.",
	"keywords": [
		"relation",
		"data",
		"relational",
		"join",
		"bridge",
		"junction"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/wayforge.git",
		"directory": "packages/rationality"
	},
	"license": "MPL-2.0",
	"author": "Jeremy Banka",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/index.js",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"junction/package.json",
		"junction/dist",
		"junction/src"
	],
	"scripts": {
		"build": "tsdown",
		"check": "pnpm run check:eslint && pnpm run check:tsc && pnpm run check:oxlint",
		"check:eslint": "eslint -- .",
		"check:oxlint": "oxlint --type-aware -c ../../.oxlintrc.jsonc .",
		"check:tsc": "tsc --noEmit",
		"postversion": "dprint fmt package.json",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"watch:types": "tsc --watch --noEmit"
	},
	"devDependencies": {
		"concurrently": "10.0.5",
		"eslint": "10.12.0",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"vite": "8.3.3",
		"vitest": "5.0.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
