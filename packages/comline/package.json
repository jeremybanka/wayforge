{
	"name": "comline",
	"version": "0.8.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/wayforge.git",
		"directory": "packages/comline"
	},
	"license": "MPL-2.0",
	"author": {
		"name": "Jeremy Banka",
		"email": "hello@jeremybanka.com"
	},
	"type": "module",
	"main": "dist/cli.js",
	"types": "dist/cli.d.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"lint:eslint": "eslint -- .",
		"lint:oxlint": "oxlint --type-aware -c ../../.oxlintrc.jsonc .",
		"lint:types": "tsc --noEmit && tsc --noEmit -p __tests__",
		"watch:types": "concurrently \"tsc --watch --noEmit\" \"tsc --watch --noEmit -p __tests__\"",
		"lint": "concurrently \"bun:lint:*\"",
		"test": "MISE_EXEC_AUTO_INSTALL=false mise exec -- vitest",
		"test:coverage:once": "MISE_EXEC_AUTO_INSTALL=false mise exec -- vitest run --coverage",
		"test:coverage:increased": "recoverage",
		"test:coverage": "pnpm test:coverage:once && pnpm test:coverage:increased",
		"test:once": "MISE_EXEC_AUTO_INSTALL=false mise exec -- vitest run",
		"test:once:public": "pnpm test:once __tests__/public",
		"test:semver": "break-check",
		"postversion": "dprint fmt package.json"
	},
	"dependencies": {
		"@standard-schema/spec": "1.1.0",
		"treetrunks": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "npm:bun-types@1.4.2",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.0.2",
		"arktype": "2.2.5",
		"break-check": "0.6.40",
		"concurrently": "10.0.5",
		"eslint": "10.11.0",
		"recoverage": "0.1.17",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"vite": "8.3.1",
		"vitest": "5.0.2",
		"zod": "4.6.5"
	},
	"peerDependencies": {
		"arktype": "^2.1.28",
		"zod": "^4.2.0"
	},
	"peerDependenciesMeta": {
		"arktype": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
