{
	"name": "comline",
	"version": "0.9.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/wayforge.git",
		"directory": "packages/comline"
	},
	"license": "MPL-2.0",
	"author": {
		"name": "Jeremy Banka",
		"email": "hello@jeremybanka.com"
	},
	"type": "module",
	"main": "dist/cli.js",
	"types": "dist/cli.d.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"check": "pnpm run check:eslint && pnpm run check:tsc && pnpm run check:oxlint",
		"check:eslint": "eslint -- .",
		"check:oxlint": "oxlint --type-aware -c ../../.oxlintrc.jsonc .",
		"check:tsc": "tsc --noEmit && tsc --noEmit -p __tests__",
		"cov": "MISE_EXEC_AUTO_INSTALL=false mise exec -- vitest run --coverage",
		"cov:check": "pnpm run cov && recoverage",
		"postversion": "dprint fmt package.json",
		"test": "MISE_EXEC_AUTO_INSTALL=false mise exec -- vitest run",
		"test:public": "pnpm test __tests__/public",
		"test:semver": "break-check",
		"test:watch": "MISE_EXEC_AUTO_INSTALL=false mise exec -- vitest --watch",
		"watch:types": "concurrently \"tsc --watch --noEmit\" \"tsc --watch --noEmit -p __tests__\""
	},
	"dependencies": {
		"@standard-schema/spec": "1.1.0",
		"treetrunks": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "npm:bun-types@1.4.2",
		"@types/node": "26.6.4",
		"@vitest/coverage-v8": "5.0.3",
		"arktype": "2.2.7",
		"break-check": "0.6.40",
		"concurrently": "10.0.5",
		"eslint": "10.11.0",
		"recoverage": "0.1.19",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"vite": "8.3.2",
		"vitest": "5.0.3",
		"zod": "4.6.5"
	},
	"peerDependencies": {
		"arktype": "^2.1.28",
		"zod": "^4.2.0"
	},
	"peerDependenciesMeta": {
		"arktype": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
