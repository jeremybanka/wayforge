{
	"name": "jurist",
	"version": "0.0.14",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/wayforge.git",
		"directory": "packages/jurist"
	},
	"license": "MPL-2.0",
	"author": {
		"name": "Jeremy Banka",
		"email": "hello@jeremybanka.com"
	},
	"type": "module",
	"main": "dist/jurist.js",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"check": "pnpm run check:eslint && pnpm run check:tsc && pnpm run check:oxlint",
		"check:eslint": "eslint -- .",
		"check:oxlint": "oxlint --type-aware -c ../../.oxlintrc.jsonc .",
		"check:tsc": "tsc --noEmit",
		"postversion": "dprint fmt package.json",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"watch:types": "tsc --watch --noEmit"
	},
	"dependencies": {
		"treetrunks": "workspace:*"
	},
	"devDependencies": {
		"concurrently": "10.0.5",
		"eslint": "10.11.0",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"vite": "8.3.2",
		"vitest": "5.0.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
