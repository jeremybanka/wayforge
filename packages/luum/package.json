{
	"name": "luum",
	"version": "0.0.18",
	"description": "generate colors dynamically",
	"keywords": [
		"color",
		"css",
		"javascript",
		"library"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/wayforge.git",
		"directory": "packages/luum"
	},
	"license": "MPL-2.0",
	"author": "Jeremy Banka",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsdown src/index.ts --format=esm --dts --platform=neutral",
		"check": "pnpm run check:eslint && pnpm run check:tsc && pnpm run check:oxlint",
		"check:eslint": "eslint -- .",
		"check:oxlint": "oxlint --type-aware -c ../../.oxlintrc.jsonc .",
		"check:tsc": "tsc --noEmit",
		"dev": "cd example && vite",
		"postversion": "dprint fmt package.json",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"watch:types": "tsc --watch --noEmit"
	},
	"devDependencies": {
		"@types/node": "26.6.4",
		"concurrently": "10.0.5",
		"eslint": "10.12.0",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"vite": "8.3.3",
		"vitest": "5.0.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
