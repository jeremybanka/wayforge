{
	"name": "tsdoc.json",
	"version": "0.6.12",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/wayforge.git",
		"directory": "packages/tsdoc.json"
	},
	"license": "MPL-2.0",
	"author": {
		"name": "Jeremy Banka",
		"email": "hello@jeremybanka.com"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/main/index.d.ts",
			"import": "./dist/main/index.js",
			"browser": "./dist/main/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.js",
			"browser": "./dist/react/index.js"
		}
	},
	"main": "dist/main/index.js",
	"types": "dist/main/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"check": "pnpm run check:eslint && pnpm run check:tsc && pnpm run check:oxlint && pnpm run check:readme",
		"check:eslint": "eslint -- .",
		"check:oxlint": "oxlint --type-aware -c ../../.oxlintrc.jsonc .",
		"check:readme": "galley check README.mdx",
		"check:tonnage": "pnpm run check:readme",
		"check:tsc": "tsc --noEmit",
		"postversion": "dprint fmt package.json",
		"readme:write": "galley write README.mdx",
		"test": "bun test -- **/*.test.ts",
		"test:watch": "bun test --watch -- **/*.test.ts",
		"tonnage:write": "pnpm run readme:write",
		"watch:types": "tsc --watch --noEmit"
	},
	"dependencies": {
		"@microsoft/tsdoc": "0.17.1"
	},
	"devDependencies": {
		"@types/bun": "npm:bun-types@1.4.4",
		"@types/react": "19.3.0",
		"concurrently": "10.0.6",
		"eslint": "10.13.0",
		"galley.md": "0.3.1",
		"react": "19.3.1",
		"tonnage": "0.5.2",
		"tsdown": "0.23.3",
		"typescript": "6.0.3"
	},
	"peerDependencies": {
		"react": "^19"
	},
	"publishConfig": {
		"access": "public"
	}
}
