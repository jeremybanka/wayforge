{
	"name": "tsdoc.json",
	"version": "0.6.11",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/wayforge.git",
		"directory": "packages/tsdoc.json"
	},
	"license": "MPL-2.0",
	"author": {
		"name": "Jeremy Banka",
		"email": "hello@jeremybanka.com"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/main/index.d.ts",
			"import": "./dist/main/index.js",
			"browser": "./dist/main/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.js",
			"browser": "./dist/react/index.js"
		}
	},
	"main": "dist/main/index.js",
	"types": "dist/main/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"check": "pnpm run check:eslint && pnpm run check:tsc && pnpm run check:oxlint && pnpm run check:tonnage",
		"check:eslint": "eslint -- .",
		"check:oxlint": "oxlint --type-aware -c ../../.oxlintrc.jsonc .",
		"check:tonnage": "tonnage check",
		"check:tsc": "tsc --noEmit",
		"lint": "pnpm run check",
		"lint:eslint": "pnpm run check:eslint",
		"lint:oxlint": "pnpm run check:oxlint",
		"lint:types": "pnpm run check:tsc",
		"postversion": "dprint fmt package.json",
		"test": "bun test -- **/*.test.ts",
		"test:once": "pnpm run test",
		"test:watch": "bun test --watch -- **/*.test.ts",
		"tonnage:check": "pnpm run check:tonnage",
		"tonnage:write": "tonnage write",
		"watch:types": "tsc --watch --noEmit"
	},
	"dependencies": {
		"@microsoft/tsdoc": "0.17.0"
	},
	"devDependencies": {
		"@types/bun": "npm:bun-types@1.4.2",
		"@types/react": "19.3.0",
		"concurrently": "10.0.5",
		"eslint": "10.11.0",
		"react": "19.3.0",
		"tsdown": "0.23.0",
		"typescript": "6.0.3"
	},
	"peerDependencies": {
		"react": "^19"
	},
	"publishConfig": {
		"access": "public"
	}
}
