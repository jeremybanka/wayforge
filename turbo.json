{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalDependencies": ["tsconfig.json", ".bun-version", ".node-version"],
	"futureFlags": {
		"strictTaskEntrypointSelection": true
	},
	"tasks": {
		"build": {
			"dependsOn": ["gen", "^build", "^gen"],
			"outputs": ["dist/**"],
			"inputs": ["**/package.json", "**/*.config.ts", "src/**", "**/src/**"]
		},
		"tempest.games#build": {
			"dependsOn": ["gen", "^build", "^gen"],
			"outputs": ["app/**", "bin/**"],
			"inputs": ["**/package.json", "src/**"]
		},
		"check:tonnage": {
			"dependsOn": ["build"],
			"cache": false
		},
		"tonnage:write": {
			"dependsOn": ["build"],
			"cache": false
		},
		"test:build": {
			"dependsOn": ["build"],
			"inputs": [
				"**/package.json",
				"src/**",
				"**/src/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"test": {
			"dependsOn": ["test:build", "^build"],
			"inputs": [
				"**/package.json",
				"vitest.config.*",
				"src/**",
				"**/src/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"comline#test": {
			"dependsOn": ["test:build", "^build"],
			"inputs": [
				"**/package.json",
				"tsconfig.json",
				".npmignore",
				"**/*.config.ts",
				"src/**",
				"__tests__/**",
				"../../mise.toml",
				"../../.github/workflows/test.yml",
				"../../.github/actions/setup/action.yml"
			]
		},
		"cov": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**", "**/coverage/**"],
			"inputs": [
				"../../.github/workflows/test.yml",
				"../../git.sha",
				"**/package.json",
				"**/*.config.ts",
				"src/**",
				"**/src/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"comline#cov": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"],
			"inputs": [
				"**/package.json",
				"tsconfig.json",
				".npmignore",
				"**/*.config.ts",
				"src/**",
				"__tests__/**",
				"../../git.sha",
				"../../mise.toml",
				"../../.github/workflows/test.yml",
				"../../.github/actions/setup/action.yml"
			]
		},
		"cov:check": {
			"dependsOn": ["^build"],
			"cache": false,
			"passThroughEnv": ["RECOVERAGE_CLOUD_TOKEN"]
		},
		"test:semver": {
			"dependsOn": ["^build"],
			"inputs": [
				"../../.changeset/**",
				"../../packages/break-check/src/**/*.ts",
				"break-check.config.json",
				"**/package.json",
				"src/**/*.{ts,tsx,css,mdx}",
				"**/src/**/*.{ts,tsx,css,mdx}",
				"__tests__/public/**/*.test.{ts,tsx}",
				"__scripts__/**/*.ts"
			]
		},
		"comline#test:semver": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"check:lasertag": {
			"inputs": [
				"../../package.json",
				"../../tsconfig.json",
				"**/package.json",
				"tsconfig.json",
				"src/frontend/**",
				"types/**"
			]
		},
		"check:eslint": {
			"dependsOn": ["gen"],
			"inputs": [
				"../../package.json",
				"../../eslint.config.ts",
				"**/package.json",
				"tsconfig.json",
				"src/**",
				"**/src/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"check:oxlint": {
			"dependsOn": ["gen"],
			"inputs": [
				"../../package.json",
				"../../.oxlintrc.jsonc",
				"**/package.json",
				"tsconfig.json",
				"src/**",
				"**/src/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"check:tsc": {
			"dependsOn": ["gen", "^check:tsc", "^build", "^gen"],
			"inputs": [
				"../../package.json",
				"../../tsconfig.json",
				"**/package.json",
				"tsconfig.json",
				"src/**",
				"**/src/**",
				"__tests__/**",
				"__scripts__/**",
				"**/*.d.ts"
			]
		},
		"watch:types": {
			"persistent": true,
			"dependsOn": ["gen", "^build", "^gen"],
			"inputs": [
				"../../package.json",
				"**/package.json",
				"tsconfig.json",
				"src/**",
				"**/src/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"check": {
			"dependsOn": [
				"check:eslint",
				"check:oxlint",
				"check:tsc",
				"check:lasertag"
			]
		},
		"gen": {
			"dependsOn": ["^build"],
			"outputs": ["**/*.gen.ts", "**/*.gen.tsx"],
			"inputs": [
				"**/package.json",
				"tsconfig.json",
				"src/**",
				"**/src/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"version": {
			"dependsOn": ["^build"],
			"inputs": [],
			"outputs": []
		},
		"test:watch": {
			"dependsOn": ["test:build", "^build"],
			"cache": false,
			"persistent": true
		}
	}
}
